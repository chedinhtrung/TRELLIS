{
    "models": {
        "denoiser": {
            "name": "SparseStructureFlowModel",
            "pretrained": "microsoft/TRELLIS-image-large/ckpts/ss_flow_img_dit_L_16l8_fp16",
            "args": {
                "resolution": 16,
                "in_channels": 8,
                "out_channels": 8,
                "model_channels": 1024,
                "cond_channels": 1024,
                "num_blocks": 24,
                "num_heads": 16,
                "mlp_ratio": 4,
                "patch_size": 1,
                "pe_mode": "ape",
                "qk_rms_norm": true,
                "use_fp16": true
            },
            "lora": {
                "rank": 8,
                "alpha": 8.0,
                "dropout": 0.0,
                "target_patterns": ["blocks."]
            },
            "init_lora_ckpt": "results/objective1_full/ss_flow/ckpts/denoiser_lora_final.pt",
            "coordinate_head": {
                "hidden_channels": 64,
                "output_resolution": 64,
                "residual_scale": 20.0,
                "base_logit_clip": 10.0,
                "freeze_backbone": true
            }
        }
    },
    "dataset": {
        "name": "ImageConditionedSparseStructureLatent",
        "args": {
            "latent_model": "o1_generated_view0_seed42",
            "min_aesthetic_score": 0.0,
            "image_size": 518,
            "view_index": 0,
            "pipeline_preprocessing": true,
            "pretrained_ss_dec": "microsoft/TRELLIS-image-large/ckpts/ss_dec_conv3d_16l8_fp16",
            "load_occupancy": true,
            "occupancy_resolution": 64,
            "interior_margin": 2
        }
    },
    "trainer": {
        "name": "ImageConditionedDecoderAwareFlowMatchingCFGTrainer",
        "args": {
            "max_steps": 2000,
            "batch_size_per_gpu": 2,
            "batch_split": 2,
            "optimizer": {
                "name": "AdamW",
                "args": {
                    "lr": 0.0001,
                    "weight_decay": 0.0001
                }
            },
            "ema_rate": [],
            "fp16_mode": "inflat_all",
            "fp16_scale_growth": 0.001,
            "grad_clip": {
                "name": "AdaptiveGradClipper",
                "args": {
                    "max_norm": 1.0,
                    "clip_percentile": 95
                }
            },
            "i_log": 100,
            "i_print": 10,
            "i_sample": 0,
            "snapshot_num_samples": 5,
            "i_save": 250,
            "sample_at_start": false,
            "sample_at_end": false,
            "p_uncond": 0.0,
            "image_cond_model": "dinov2_vitl14_reg",
            "pretrained_ss_decoder": "microsoft/TRELLIS-image-large/ckpts/ss_dec_conv3d_16l8_fp16",
            "empty_loss_weight": 1.0,
            "exterior_loss_weight": 2.0,
            "interior_loss_weight": 4.0,
            "interior_aux_weight": 0.1,
            "adapter_only_checkpoints": true
        }
    }
}
